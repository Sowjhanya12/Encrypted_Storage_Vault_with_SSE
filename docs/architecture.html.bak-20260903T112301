          <text x="110" y="128" text-anchor="middle" font-family="Archivo,sans-serif" font-size="14" font-weight="700" fill="var(--ink)">Browser UI</text>
          <text x="110" y="148" text-anchor="middle" font-family="Archivo,sans-serif" font-size="11.5" fill="var(--muted)">thin shell, no crypto</text>
